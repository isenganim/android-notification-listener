<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- FlushWorker memakai setExpedited, yang bisa jatuh ke foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Hanya untuk notifikasi tes milik aplikasi sendiri (util/ListenerProbe.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Sejak Android 11 aplikasi tidak bisa melihat paket lain tanpa deklarasi ini; tanpa itu
         semua gateway tampak "belum terpasang". Cukup filter intent LAUNCHER — aplikasi berikon
         peluncur saja yang terlihat, BUKAN QUERY_ALL_PACKAGES yang membuka seluruh isi perangkat. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false: secret endpoint tidak boleh ikut tersalin ke cloud lalu dipulihkan ke
         perangkat lain. Data lain di sini bisa diisi ulang. -->
    <!-- usesCleartextTraffic: endpoint diisi user saat runtime dan hampir selalu server LAN
         (http://192.168.x.x:8080), jadi alamatnya tidak bisa didaftarkan di network security
         config yang menuntut daftar domain tetap. Tanpa ini Android 9+ memblokir semua HTTP dan
         aplikasi tidak bisa dipakai untuk kasus utamanya. Konsekuensinya isi notifikasi lewat
         jaringan tanpa enkripsi — pakai HTTPS bila keluar dari jaringan lokal. -->
    <application
        android:name=".ListenerApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.SaquoneNotificationListener">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SaquoneNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
